---
layout: compress
---

{% assign brand_icon = "/assets/brand/kf-avatar-dark" | relative_url %}

{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "icons": [
    {
      "src": "{{ brand_icon }}.svg",
      "sizes": "1024x1024",
      "type": "image/svg+xml"
    },
    {
      "src": "{{ brand_icon }}.png",
      "sizes": "1024x1024",
      "type": "image/png"
    }],
  "start_url": "{{ '/index.html' | relative_url }}",
  "theme_color": "#101416",
  "background_color": "#101416",
  "display": "fullscreen"
}
